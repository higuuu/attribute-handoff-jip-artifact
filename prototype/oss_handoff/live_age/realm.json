{
  "realm": "live-age",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "users": [{
    "id": "10000000-0000-4000-8000-000000009001",
    "username": "synthetic-age-user",
    "firstName": "Synthetic",
    "lastName": "Resident",
    "email": "synthetic-age-user@example.invalid",
    "emailVerified": true,
    "enabled": true,
    "attributes": {"birth_date": ["2008-09-27"]},
    "credentials": [{"type": "password", "value": "synthetic-local-only", "temporary": false}]
  }],
  "clients": [{
    "clientId": "source-internal-adapter",
    "enabled": true,
    "publicClient": false,
    "secret": "synthetic-adapter-only",
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": false,
    "protocol": "openid-connect",
    "protocolMappers": [
      {
        "name": "source-birth-date",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "user.attribute": "birth_date",
          "claim.name": "birth_date",
          "jsonType.label": "String",
          "id.token.claim": "false",
          "access.token.claim": "true",
          "userinfo.token.claim": "false"
        }
      },
      {
        "name": "internal-adapter-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "source-internal-adapter",
          "id.token.claim": "false",
          "access.token.claim": "true",
          "introspection.token.claim": "false"
        }
      }
    ]
  }]
}
