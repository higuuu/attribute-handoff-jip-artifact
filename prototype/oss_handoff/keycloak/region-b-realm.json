{
  "realm": "region-b",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "clients": [
    {
      "clientId": "region-b-app",
      "name": "Region B synthetic relying party",
      "enabled": true,
      "publicClient": false,
      "secret": "local-region-b-app-only",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://runner.invalid/callback"]
