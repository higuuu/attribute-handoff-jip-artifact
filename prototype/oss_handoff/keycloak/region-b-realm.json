        "issuer": "http://region-a:8080/realms/region-a",
        "clientId": "region-b-broker",
        "clientSecret": "local-broker-only",
        "defaultScope": "openid",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "syncMode": "FORCE",
